{
  "name": "liby2",
  "version": "0.0.0",
  "description": "Embed y2 agents and terminals in JavaScript hosts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobalo/y2-intel.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/tobalo/y2-intel/tree/main/sdk#readme",
  "bugs": "https://github.com/tobalo/y2-intel/issues",
  "scripts": {
    "test:node-wasm": "node tests/test-node-wasm.mjs",
    "test:node-napi": "node tests/test-node-napi.mjs",
    "test:browser-wasm": "node tests/test-browser-wasm.mjs"
  },
  "exports": {
    ".": {
      "node": "./node.js",
      "browser": "./browser.js",
      "default": "./browser.js"
    },
    "./node": "./node.js",
    "./browser": "./browser.js",
    "./wasm": "./y2-sdk.js"
  },
  "files": [
    "browser.js",
    "node.js",
    "y2-sdk.js",
    "y2-core.wasm",
    "y2-term.wasm",
    "*.node",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Apache-2.0"
}
